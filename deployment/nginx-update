upstream afrilearn_app {
    server 127.0.0.1:8001;
}

server {
    listen 80;
    server_name elearnapi.afrilearntech.com elapi.afrilearntech.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name elearnapi.afrilearntech.com elapi.afrilearntech.com;
    ssl_certificate /etc/letsencrypt/live/elearnapi.afrilearntech.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/elearnapi.afrilearntech.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 100M;

    location / {
       include proxy_params;
       proxy_pass http://afrilearn_app;
    }

    location /static/ {
        alias /srv/elearncore/staticfiles/;
        access_log off;
        expires 1h;
    }
}
